[
  {
    "id": "flood_emergency",
    "chainId": "flood_response_chain",
    "nodeId": "unprepared_emergency",
    "title": "防汛抗洪（准备不足）",
    "description": "暴雨导致辖区发生严重内涝。由于前期准备不足，物资、预警和值守均存在缺口，必须立即组织抢险救灾。",
    "category": "emergency",
    "priority": "urgent",
    "presentation": "blocking",
    "trigger": {
      "sources": ["world.metric_changed"],
      "condition": {
        "all": [
          { "worldMetric": "flood_risk", "op": "gte", "value": 80 },
          { "fact": "flood_prepared", "op": "is_false" }
        ]
      },
      "probability": 1
    },
    "repeatPolicy": {
      "mode": "repeatable",
      "cooldownDays": 120
    },
    "activation": {
      "deadlineDays": 3
    },
    "options": [
      {
        "id": "frontline_command",
        "label": "亲临一线指挥",
        "description": "亲自到受灾现场指挥抢险，调动所有可用资源。",
        "effects": [
          { "target": "character", "field": "performance", "operation": "add", "value": 8 },
          { "target": "character", "field": "charisma", "operation": "add", "value": 3 },
          {
            "target": "world_fact",
            "factId": "flood_handled_personally",
            "operation": "set",
            "value": true
          }
        ],
        "schedule": [{ "eventId": "flood_reconstruction", "delayDays": 5 }]
      },
      {
        "id": "coordinate_rescue",
        "label": "组织协调救援",
        "description": "在指挥部统筹协调各部门，保障救援有序进行。",
        "effects": [
          { "target": "character", "field": "performance", "operation": "add", "value": 5 },
          { "target": "character", "field": "competence", "operation": "add", "value": 2 }
        ],
        "schedule": [{ "eventId": "flood_accountability", "delayDays": 2 }]
      },
      {
        "id": "request_support",
        "label": "请求上级支援",
        "description": "立即向上级报告请求支援，等待上级派员指挥。",
        "effects": [
          { "target": "character", "field": "performance", "operation": "add", "value": 2 },
          { "target": "character", "field": "network", "operation": "add", "value": -3 }
        ],
        "schedule": [{ "eventId": "flood_accountability", "delayDays": 2 }]
      }
    ]
  },
